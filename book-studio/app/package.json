{
  "name": "book-studio-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:demo": "VITE_DEMO=true tsc -p tsconfig.json && VITE_DEMO=true vite build",
    "build:hostinger": "VITE_DEMO=true VITE_LIVE_AI_URL=https://book-studio-demo.vercel.app/api/ai tsc -p tsconfig.json && VITE_DEMO=true VITE_LIVE_AI_URL=https://book-studio-demo.vercel.app/api/ai vite build --outDir dist-hostinger && cp hostinger/.htaccess dist-hostinger/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-georgian": "^0.4.4",
    "@supabase/supabase-js": "^2.119.0",
    "diff": "^9.0.0",
    "docx": "^9.15.4",
    "jszip": "^3.10.2",
    "pdfmake": "^0.3.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-xml-parser": "^5.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
